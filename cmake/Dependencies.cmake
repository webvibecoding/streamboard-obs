# Pinned official OBS SDK and dependencies. Never distribute a second copy of Qt.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/buildspec.json" spec)
set(deps "${CMAKE_CURRENT_SOURCE_DIR}/.deps")
file(MAKE_DIRECTORY "${deps}")
foreach(dep IN ITEMS prebuilt qt6 obs-studio)
  string(JSON ver GET "${spec}" dependencies ${dep} version)
  string(JSON hash GET "${spec}" dependencies ${dep} sha256)
  if(dep STREQUAL "obs-studio")
    set(archive "${ver}.zip")
    set(url "https://github.com/obsproject/obs-studio/archive/refs/tags/${archive}")
    set(destination "${deps}")
    set(root "${deps}/obs-studio-${ver}")
  else()
    if(dep STREQUAL "qt6")
      set(archive "windows-deps-qt6-${ver}-x64.zip")
    else()
      set(archive "windows-deps-${ver}-x64.zip")
    endif()
    set(url "https://github.com/obsproject/obs-deps/releases/download/${ver}/${archive}")
    set(root "${deps}/${dep}-${ver}")
    set(destination "${root}")
  endif()
  if(NOT EXISTS "${deps}/${archive}")
    file(DOWNLOAD "${url}" "${deps}/${archive}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON SHOW_PROGRESS)
  endif()
  file(SHA256 "${deps}/${archive}" actual)
  if(NOT actual STREQUAL hash)
    message(FATAL_ERROR "Dependency checksum mismatch: ${archive}")
  endif()
  if(NOT EXISTS "${root}/.streamboard-extracted")
    file(MAKE_DIRECTORY "${destination}")
    file(ARCHIVE_EXTRACT INPUT "${deps}/${archive}" DESTINATION "${destination}")
    file(WRITE "${root}/.streamboard-extracted" "${hash}")
  endif()
  if(dep STREQUAL "obs-studio")
    set(obs_source "${root}")
  else()
    list(APPEND CMAKE_PREFIX_PATH "${root}")
  endif()
endforeach()
set(sdk "${deps}/sdk")
if(NOT EXISTS "${sdk}/.streamboard-sdk-33.0.1")
  file(MAKE_DIRECTORY "${obs_source}/.deps")
  foreach(dep IN ITEMS prebuilt qt6)
    string(JSON hash GET "${spec}" dependencies ${dep} sha256)
    file(WRITE "${obs_source}/.deps/.dependency_${dep}_x64.sha256" "${hash}")
  endforeach()
  # Build only the public libraries; OBS's frontend API target is available with frontend disabled.
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${obs_source}" -B "${deps}/obs-build"
    -G "${CMAKE_GENERATOR}" -A "x64,version=10.0.26100.0"
    "-DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH}" -DENABLE_CORE_MODULES=OFF -DENABLE_FRONTEND=OFF
    -DENABLE_BROWSER=OFF -DENABLE_SCRIPTING=OFF -DOBS_VERSION_OVERRIDE=33.0.1
    COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${deps}/obs-build" --config Release
    --target obs-frontend-api --parallel 4 COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${deps}/obs-build" --config Release
    --component Development --prefix "${sdk}" COMMAND_ERROR_IS_FATAL ANY)
  file(WRITE "${sdk}/.streamboard-sdk-33.0.1" "33.0.1")
endif()
list(PREPEND CMAKE_PREFIX_PATH "${sdk}")
